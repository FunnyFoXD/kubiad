operator CorpusApplication {
    api {
        group = "apps.kubiad.dev"
        version = "v1alpha1"
        kind = "CorpusApplication"
    }
    spec {
        image: string { required }
        replicas: int { default = 1 range = 0..10 }
        port: int { default = 8080 range = 1..65535 }
        enabled: bool { default = true }
    }
    status {
        phase: string
        readyReplicas: int
    }
    resources {
        deployment application {
            image = spec.image
            replicas = spec.replicas
        }
        service applicationService {
            target = deployment.application
            port = spec.port
        }
    }
    reconcile {
        when deployment.application.ready {
            status.phase = "Ready"
            status.readyReplicas = deployment.application.readyReplicas
        }
        otherwise {
            status.phase = "Progressing"
            status.readyReplicas = deployment.application.readyReplicas
        }
    }
}
